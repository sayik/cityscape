# cityscape API - Sample Environment Variables
# Copy to .env and fill in the values. .env is NOT committed.
# All variables read by the app have the prefix CITYSCAPE_
# (Settings.env_prefix). DO NOT enter any actual secrets in this file.

# --- Infrastructure ---
CITYSCAPE_LOG_LEVEL=INFO
CITYSCAPE_REDIS_URL=redis://redis:6379/0
# CORS whitelist (JSON list), never use “*”
CITYSCAPE_CORS_ORIGINS=["http://localhost:3000"]

# --- Phase 11: Rate Limiting + API Keys (API-06/API-07) ---
# Rate-limit tiers in the limits/slowapi format “<number>/<unit>”. anon = anonymous
# IP budget, keyed = budget with a valid X-API key (lifts the limit), mint =
# strict budget at the key-mint endpoint to prevent key flooding.
CITYSCAPE_LIMIT_ANON=300/minute
CITYSCAPE_LIMIT_KEYED=600/minute
CITYSCAPE_LIMIT_MINT=3/hour
# Rate limit per ChatGPT-GPT user (ephemeral OpenAI user ID). Backstop
# for the OpenAI egress ranges exempted from the IP limit via CITYSCAPE_RATELIMIT_ALLOWLIST
# (openai.com/chatgpt-actions.json). Empty = disabled.
CITYSCAPE_LIMIT_GPT=480/minute
# Strict budget on the admin login to prevent brute-force attacks (Audit HIGH-1).
CITYSCAPE_LIMIT_ADMIN_LOGIN=5/minute
# Sync Redis URI for SlowAPI's own limits storage. Leave blank to fall back to
# CITYSCAPE_REDIS_URL (same server, separate sync connection; SlowAPI does not
# share the async pool). Example: redis://redis:6379/0
CITYSCAPE_LIMIT_STORAGE_URI=
# Optional pepper for the API key hash. Leave blank = pure SHA-256 hash of the
# token. Set = pepper is appended before hashing. NO actual secret here.
CITYSCAPE_APIKEY_PEPPER=

# --- Phase 13: Admin Dashboard (OPS-01/OPS-02) ---
# Password for the cookie-protected /admin dashboard. Leave blank = Login
# not possible (fail-closed, no access). DO NOT include any actual secrets in this file.
CITYSCAPE_ADMIN_PASSWORD=
# Signing secret for the session cookie (itsdangerous). At least 32 bytes
# Use a random value (e.g., `python -c “import secrets; print(secrets.token_hex(32))”`).
# Leave blank = session cannot be signed (fail-closed).
CITYSCAPE_ADMIN_SESSION_SECRET=
# Maximum number of request logs stored in the Redis ring buffer (the oldest ones are
# discarded). Default: 200.
CITYSCAPE_ADMIN_LOG_MAX=200
# Secure flag for the session cookie. true = Cookie only via HTTPS (production behind
# Caddy/Cloudflare). Set to false only locally or in tests without TLS.
CITYSCAPE_ADMIN_COOKIE_HTTPS_ONLY=true

# --- Source Toggles (true/false): Each source can be enabled individually (FND-02)---
CITYSCAPE_ENABLE_WIKIDATA=true
CITYSCAPE_ENABLE_DWD=true
CITYSCAPE_ENABLE_OVERPASS=true
# Overpass endpoint. Default = public instance (for light use only). The
# public instance prohibits third-party backends from continuous operation (fair use);
# for production, enter your own instance (Planet-Dump) or Geofabric.
CITYSCAPE_OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
CITYSCAPE_ENABLE_AUTOBAHN=true
CITYSCAPE_ENABLE_HVV=false
CITYSCAPE_ENABLE_DELFI=false
# Phase 7: Tier-A sources (e-mobility and expanded environmental data),
# all keyless and nationwide, so default is true. enable_lhp = Flood (LHP).
# BNETZA: The toggle controls only the /charging route (snapshot read); the data
# comes from an offline-updated CSV dataset and is no longer live.
CITYSCAPE_ENABLE_BNETZA=true
CITYSCAPE_ENABLE_UBA=true
CITYSCAPE_ENABLE_PEGELONLINE=true
CITYSCAPE_ENABLE_LHP=true
CITYSCAPE_ENABLE_DWD_POLLEN=true
# Phase 8: Account-gated sources (default: false; credentials required):
# GENESIS = Demographics + Hospitals (regionalstatistik.de), ZENSUS = Census Host,
# DIVI = Hospital-Specific Live ICU Beds (Tier C, optional). Keyless Bulk/Seed
# Sources Default true (MaStR-Energy, BKG-Geo, Federal Elections, Holidays/Vacations).
CITYSCAPE_ENABLE_GENESIS=false
CITYSCAPE_ENABLE_ZENSUS=false
CITYSCAPE_ENABLE_DIVI=false
CITYSCAPE_ENABLE_MASTR=true
CITYSCAPE_ENABLE_BKG=true
CITYSCAPE_ENABLE_BUNDESWAHL=true
CITYSCAPE_ENABLE_FEIERTAGE=true
# BKA-PKS Crime Statistics by District (Bulk-XLSX, keylos DL-DE/BY, Tier A). Only
# Toggle, no Secret; the ingest retrieves the most recent year's data in real time from www.bka.de.
CITYSCAPE_ENABLE_BKA_PKS=true
# BBK NINA Civil Protection Alerts by City (keylos, ARS-based, official
# source = Tier A, alert text verbatim). Toggle only, no secret.
CITYSCAPE_ENABLE_BBK_NINA=true
# Phase 9: Keyless city traffic sources (construction zones/road closures) per city +
# highway webcam sub-service. All keyless, so default is true (similar to
# CITYSCAPE_ENABLE_AUTOBAHN). No new secrets.
CITYSCAPE_ENABLE_BERLIN_VIZ=true
CITYSCAPE_ENABLE_HAMBURG_BAUSTELLEN=true
CITYSCAPE_ENABLE_KOELN_VERKEHR=true
CITYSCAPE_ENABLE_MUENCHEN_BAUSTELLEN=true
CITYSCAPE_ENABLE_MOBIDATA_BW=true
CITYSCAPE_ENABLE_AUTOBAHN_WEBCAM=true
# Phase 10: City Events. destination.one is KEYLOS: the
# “open-data” experience is freely accessible (support confirmation 2026-06-10),
# so the default is true. koeln_events is also KEYLOS; the default is true.
CITYSCAPE_ENABLE_DESTINATION_ONE=true
CITYSCAPE_ENABLE_KOELN_EVENTS=true

# --- API Keys / Credentials (leave blank = source unavailable, graceful degradation) ---
# HVV / Geofox (Hamburg): Key provided by agreement
CITYSCAPE_HVV_API_KEY=
# GENESIS / Regional Statistics (account-gated POST API). Account at
# regionalstatistik.de -> Registration/My Account. Note: The “Settings” field
# is named genesis_username, so it maps to CITYSCAPE_GENESIS_USERNAME (NOT
# CITYSCAPE_GENESIS_USER). Any existing SOURCE_GENESIS_ENABLED variable
# is legacy and is NOT read; only CITYSCAPE_ENABLE_GENESIS takes effect.
CITYSCAPE_GENESIS_USERNAME=
CITYSCAPE_GENESIS_PASSWORD=
# Regionalstatistik.de GENESIS Web Service (DATA-37: Property tax rates 71231 +
# Business registrations/deregistrations 52311). Header authentication (username/password), ONLY in bulk ingest
# (python -m cityscape.ingest.regionalstatistik), NEVER in the request path. Without these
# credentials, /tax-rates and /business-registrations return 200 (disabled).
CITYSCAPE_REGIO_USER=
CITYSCAPE_REGIO_PASS=
# Census (ergebnisse.zensus2022.de): possibly a separate account (RESEARCH A4).
CITYSCAPE_ZENSUS_USER=
CITYSCAPE_ZENSUS_PASSWORD=
# RMV HAPI (Rhine-Main, Frankfurt): accessId authentication, https://www.rmv.de/hapi/.
# Open Data, but NO GTFS (only stop file at opendata.rmv.de). Tier/License
# Test BEFORE production use (presumably Tier C live-only, like HVV/geofox).
# API migration to v2.52.0 as of 2026-09-22 (test environment https://www.rmv.de/hapi/latest/).
CITYSCAPE_RMV_ACCESS_ID=
# destination.one / eT4.META (City Events, Phase 10): NO key required; the
# “open-data” experience is freely accessible (verified 2026-06-10).

# --- Local Data Directory ---
# Root path of the local data directory (field/env name left
# unchanged for compatibility reasons).
# Mounted as a volume in Docker (deploy/docker-compose.yml).
# CITYSCAPE_ARCHIVE_DIR=data/archive

# --- Operational notes for later phases (not yet read by Settings) ---
# Mandatory user agent for Wikidata/Overpass/DWD (fair use), starting in Phase 3/4
# CITYSCAPE_HTTP_USER_AGENT=cityscape/0.1 (+https://github.com/street1983nk/cityscape-api; contact@example.com)
# DELFI / opendata-oepnv.de: no runtime key, GTFS ZIP path/URL, starting in Phase 6
# CITYSCAPE_DELFI_GTFS_PATH=./data/delfi/gtfs.zip
# Phase 8: local bulk file paths for offline processing, never in the
# request path. None/unset = processing not executable.
# CITYSCAPE_MASTR_ZIP_PATH=./data/mastr/Gesamtdatenexport.zip
# CITYSCAPE_BKG_PATH=./data/bkg/vg250.geojson
# CITYSCAPE_BUNDESWAHL_CSV_PATH=./data/bundeswahl/kerg2.csv
# CITYSCAPE_DIVI_CSV_PATH=./data/divi/divi_landkreise.csv

# --- Mobilithek M2M (DATEX-II V2 Pull, mutual TLS, Port 8443) ---
# Organization’s machine account certificate (.p12), a single certificate for ALL subscribed Mobilithek services.
# Available via the Mobilithek portal -> My Organization -> Machine Accounts -> “Request Certificate”.
# Place the `.gitignored` file in the `secrets/` directory (DO NOT commit it); store the password only in `.env`.
CITYSCAPE_MOBILITHEK_CERT_PATH=secrets/mobilithek-<name>.p12
CITYSCAPE_MOBILITHEK_CERT_PASSWORD=
# eRound subscriptions (DATA-42 live charging occupancy): dynamic (occupancy deltas, bollards)
# + static (full location inventory ~94 MB, daily geo-map ingest).
# CITYSCAPE_EROUND_CHARGING_ABO_ID=
# CITYSCAPE_EROUND_LOCATIONS_ABO_ID=
# Storage of the geo-map in the data volume (default works for Compose-Prod).
# CITYSCAPE_EROUND_GEO_MAP_PATH=data/eround/eround_geo_map.json

# --- Phase 14: Hetzner Deployment + Cloudflare (DEP-01/DEP-02) ---
# Cloudflare API token for Caddy’s DNS-01 challenge (Auto-HTTPS in production). Keep scope
# minimal: Zone.Zone:Read + Zone.DNS:Edit, ONLY for the cityscape.dev zone.
# This token is read EXCLUSIVELY by Caddy via the {env....} reference in the Caddyfile,
# NOT by the app’s Pydantic settings. Leave it blank in the repo; never
# commit a real token (gitleaks-CI catches accidental secrets, FND-07).
CITYSCAPE_CF_DNS_TOKEN=
# Public API domain (Caddy site block + documentation/CORS reference).
CITYSCAPE_PUBLIC_DOMAIN=cityscape.dev

# --- Phase 16: Monitoring/Alerting/Self-Healing (OPS-06/07/08) ---
# ntfy push channel for alerts. CITYSCAPE_NTFY_URL = Base URL of the ntfy server
# (self-hosted or https://ntfy.sh). CITYSCAPE_NTFY_TOPIC is effectively a
# password (use only a-z/0-9/_/-; do not let anyone guess it). CITYSCAPE_NTFY_TOKEN
# = Bearer access token. All three should only be configured via .env; never include them in the repo (NOT a true secret).
CITYSCAPE_NTFY_URL=
CITYSCAPE_NTFY_TOPIC=
CITYSCAPE_NTFY_TOKEN=
# SMTP email backup channel. CITYSCAPE_SMTP_SSL=false = STARTTLS on port 587
# (default), true = SMTP_SSL on port 465. CITYSCAPE_SMTP_PASSWORD only via .env,
# never in the repo (NOT a real secret). Leave blank = email backup disabled.
CITYSCAPE_SMTP_HOST=
CITYSCAPE_SMTP_PORT=587
CITYSCAPE_SMTP_USER=
CITYSCAPE_SMTP_PASSWORD=
CITYSCAPE_SMTP_FROM=
CITYSCAPE_SMTP_TO=
CITYSCAPE_SMTP_SSL=false
# Dead-man ping per timer job (Kuma Push or Healthchecks.io ping URL). Overwritten via
# systemd drop-in per job. Leave blank = no ping. The URL contains a
# token/UUID and should be treated as a secret (only via .env, never in the repo).
CITYSCAPE_DEADMAN_URL=
# External box liveness ping (Finding 8): The watchdog pings this URL at the end
# of every successful run. The URL contains a UUID and should be treated like a secret
# (only via .env, never in the repo, similar to DEADMAN_URL; HTTPS destination).
CITYSCAPE_HEALTHCHECKS_URL=
# Self-Heal Reprobe (A, 2026-06-14): opt-in list of sources that have been DELIBERATELY disabled via the enable_* toggle
# whose upstream the watchdog periodically probes directly.
# If the upstream is back online, exactly one “X can be reactivated” notification is sent (reactivation
# must be done manually). Format is comma-separated: source=ProbeURL,source2=ProbeURL2.
# Example: hamburg_traffic=https://api.hamburg.de/datasets/v1/verkehrslage/collections/verkehrslage/items?f=json&limit=1
# Empty = off. (Sources left enabled will recover anyway via the persistent
# breaker with per-source cooldown; no entry required.)
CITYSCAPE_SELFHEAL_PROBES=

# Capacity/Saturation Early Warning: The watchdog sends a WARNING push notification
# BEFORE an API replica becomes saturated (Level 1: alarm only, no auto-scaling).
# Deliberately conservative defaults (early warning, no capacity controller):
#   CITYSCAPE_CAPACITY_LOAD_PER_CORE_WARN  1-minute load per core (headroom on the 8-vCPU box)
#   CITYSCAPE_CAPACITY_REDIS_MEM_WARN      Redis memory usage ratio used_memory/maxmemory (0 = signal off)
#   CITYSCAPE_CAPACITY_HYSTERESIS_TICKS    consecutive exceedances until an alarm is triggered (to prevent flapping)
CITYSCAPE_CAPACITY_LOAD_PER_CORE_WARN=0.75
CITYSCAPE_CAPACITY_REDIS_MEM_WARN=0.80
CITYSCAPE_CAPACITY_HYSTERESIS_TICKS=2

# --- MCP/Redis Connection Backpressure ---
# Three defensive limits to prevent connection pool exhaustion. Purely defensive: during
# normal operation, NOTHING changes (the defaults reflect the previous
# effective values); the limits only take effect during overload. The stateless_http-
# migration of the MCP server is deliberately NOT part of this.
#   CITYSCAPE_MCP_LIMIT_CONCURRENCY        the only truly new limit: maximum concurrent MCP sessions; beyond this, uvicorn returns a 503 (previously unlimited)
#   CITYSCAPE_MCP_TIMEOUT_KEEP_ALIVE       uvicorn keep-alive in seconds (= uvicorn default, explicit only)
#   CITYSCAPE_MCP_BACKLOG                  uvicorn TCP backlog (= uvicorn default, explicit only)
#   CITYSCAPE_REDIS_MAX_CONNECTIONS        Cap on the Redis pool to prevent unlimited socket growth (previously unlimited)
#   CITYSCAPE_MCP_LOOPBACK_MAX_CONNECTIONS Maximum connections for the MCP loopback httpx client (= httpx default)
#   CITYSCAPE_MCP_LOOPBACK_MAX_KEEPALIVE   Maximum keep-alive connections for the loopback client (= httpx default)
#   CITYSCAPE_MCP_LOOPBACK_POOL_TIMEOUT    SHORT pool acquire limit for the loopback client in seconds (previously 30s)
#   CITYSCAPE_MCP_LOOPBACK_READ_TIMEOUT    Read timeout for the loopback client in seconds (intentionally generous, slow upstreams)
CITYSCAPE_MCP_LIMIT_CONCURRENCY=256
CITYSCAPE_MCP_TIMEOUT_KEEP_ALIVE=5
CITYSCAPE_MCP_BACKLOG=2048
CITYSCAPE_REDIS_MAX_CONNECTIONS=150
CITYSCAPE_MCP_LOOPBACK_MAX_CONNECTIONS=100
CITYSCAPE_MCP_LOOPBACK_MAX_KEEPALIVE=20
CITYSCAPE_MCP_LOOPBACK_POOL_TIMEOUT=1.0
CITYSCAPE_MCP_LOOPBACK_READ_TIMEOUT=30.0

# --- MANDATORY Production Note (must be set before the public launch) ---
# The following variables, already defined above, MUST contain valid
# values in production; otherwise, operation is unsafe or fail-closed (no access):
#   CITYSCAPE_ADMIN_PASSWORD         - without a value, /admin login is impossible
#   CITYSCAPE_ADMIN_SESSION_SECRET   - without a value, no session can be signed
#       Generate both using `python -c “import secrets; print(secrets.token_hex(32))”`
#   CITYSCAPE_ADMIN_COOKIE_HTTPS_ONLY=true  - Required in production (cookie only via HTTPS)
#   CITYSCAPE_CORS_ORIGINS           - Set to the actual Docs/cityscape.dev domain in production
#       (e.g., [“https://cityscape.dev”]), NEVER “*”.
